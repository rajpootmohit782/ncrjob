# Copy this file to .env and fill in the values.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public Razorpay key id (test or live)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Direct APK download on /download (set to false after Play Store launch)
VITE_SHOW_APK_DOWNLOAD=true
# Optional: override the APK URL (defaults to /apk/VMWjobs-v1.0.apk)
# VITE_APK_URL=https://github.com/rajpootmohit782/ncrjob/releases/download/v1.0/VMWjobs-v1.0.apk

# Server-only — never prefix with VITE_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
